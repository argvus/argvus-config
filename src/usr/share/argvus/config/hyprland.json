{
  "window_rules": {
    "browser": {
      "workspace": 2,
      "classes": ["firefox.*", "chromium.*", "google-chrome.*", "brave-browser.*", "librewolf.*", "zen-browser.*"]
    },
    "ide": {
      "workspace": 1,
      "classes": ["[Cc]ode.*", "cursor", "jetbrains-.*", "dev.zed.Zed"]
    }
  },
  "input": {
    "mouse": {
      "accel_profile": "flat",
      "left_handed": false,
      "natural_scroll": false,
      "scroll_factor": 1.0,
      "sensitivity": 0.0
    },
    "touchpad": {
      "disable_while_typing": true,
      "natural_scroll": false,
      "tap_and_drag": true,
      "tap_to_click": true,
      "two_finger_right_click": false
    }
  }
}
