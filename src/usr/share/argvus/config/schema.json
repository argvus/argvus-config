{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ARGVUS user configuration",
  "type": "object",
  "required": ["schema_version"],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "appearance": {
      "type": "object",
      "properties": {
        "theme": { "type": "string", "minLength": 1 },
        "accent": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
        "accent_custom": { "type": "boolean" },
        "gtk_mode": { "enum": ["light", "dark", "auto", "sticky"] },
        "wallpaper": { "type": ["string", "null"] },
        "wallpaper_custom": { "type": "boolean" },
        "colors": {
          "type": "object",
          "properties": {
            "window_border_active": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
            "window_border_inactive": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
            "group_border_active": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
            "group_border_inactive": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
            "taskbar_border": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" }
          }
        }
      }
    },
    "layout": {
      "type": "object",
      "properties": {
        "variant": { "enum": ["sticky", "float"] },
        "window": {
          "type": "object",
          "properties": {
            "gaps_in": { "type": "integer", "minimum": 0, "maximum": 100 },
            "gaps_out": { "type": "integer", "minimum": 0, "maximum": 100 },
            "gaps_out_top": { "type": "integer", "minimum": 0, "maximum": 100 },
            "gaps_out_left": { "type": "integer", "minimum": 0, "maximum": 100 },
            "gaps_out_right": { "type": "integer", "minimum": 0, "maximum": 100 },
            "gaps_out_bottom": { "type": "integer", "minimum": 0, "maximum": 100 },
            "rounded": { "type": "boolean" },
            "border_size": { "type": "integer", "minimum": 0, "maximum": 10 },
            "rounding": { "type": "integer", "minimum": 0, "maximum": 10 }
          }
        },
        "taskbar": {
          "type": "object",
          "properties": {
            "position": { "enum": ["top", "bottom", "left", "right"] },
            "margin_top": { "type": "integer", "minimum": 0, "maximum": 100 },
            "margin_bottom": { "type": "integer", "minimum": 0, "maximum": 100 },
            "margin_left": { "type": "integer", "minimum": 0, "maximum": 100 },
            "margin_right": { "type": "integer", "minimum": 0, "maximum": 100 }
          }
        }
      }
    },
    "effects": {
      "type": "object",
      "properties": {
        "animations": { "type": "boolean" },
        "widget_telemetry_enabled": { "type": "boolean" },
        "blur_global_enabled": { "type": "boolean" },
        "blur_global_value": { "type": "integer", "minimum": 0, "maximum": 100 },
        "transparency_taskbar_enabled": { "type": "boolean" },
        "transparency_taskbar_value": { "type": "integer", "minimum": 0, "maximum": 100 },
        "blur_taskbar_enabled": { "type": "boolean" },
        "transparency_launchers_enabled": { "type": "boolean" },
        "transparency_launchers_value": { "type": "integer", "minimum": 0, "maximum": 100 },
        "blur_launchers_enabled": { "type": "boolean" },
        "transparency_widget-telemetry_enabled": { "type": "boolean" },
        "transparency_widget-telemetry_value": { "type": "integer", "minimum": 0, "maximum": 100 },
        "blur_widget-telemetry_enabled": { "type": "boolean" },
        "transparency_control-panel_enabled": { "type": "boolean" },
        "transparency_control-panel_value": { "type": "integer", "minimum": 0, "maximum": 100 },
        "blur_control-panel_enabled": { "type": "boolean" },
        "transparency_terminal_enabled": { "type": "boolean" },
        "transparency_terminal_value": { "type": "integer", "minimum": 0, "maximum": 100 },
        "blur_terminal_enabled": { "type": "boolean" },
        "transparency_control-center_enabled": { "type": "boolean" },
        "transparency_control-center_value": { "type": "integer", "minimum": 0, "maximum": 100 },
        "blur_control-center_enabled": { "type": "boolean" }
      }
    },
    "taskbar": {
      "type": "object",
      "properties": {
        "icons": {
          "type": "object",
          "properties": {
            "audio_player_enabled": { "type": "boolean" },
            "launcher_enabled": { "type": "boolean" },
            "network_enabled": { "type": "boolean" },
            "power_profile_enabled": { "type": "boolean" },
            "keyboard_layout_enabled": { "type": "boolean" },
            "memory_enabled": { "type": "boolean" },
            "cpu_enabled": { "type": "boolean" },
            "cpu_temperature_enabled": { "type": "boolean" },
            "gpu_temperature_enabled": { "type": "boolean" },
            "utilities": {
              "type": "object",
              "properties": {
                "expanded": { "type": "boolean" }
              }
            }
          }
        },
        "date": {
          "type": "object",
          "properties": {
            "format": {
              "enum": [
                "weekday_day_month",
                "weekday_day_month_year",
                "weekday_day_slash_month_year",
                "numeric_short_locale_aware"
              ]
            }
          }
        },
        "time": {
          "type": "object",
          "properties": {
            "seconds_enabled": { "type": "boolean" },
            "format": { "enum": ["24h", "12h"] }
          }
        }
      }
    },
    "fonts": {
      "type": "object",
      "properties": {
        "targets": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "family": { "type": "string" },
              "style": { "type": "string" },
              "size": { "type": "integer", "minimum": 8, "maximum": 32 }
            }
          }
        },
        "rendering": {
          "type": "object",
          "properties": {
            "antialias": { "type": "boolean" },
            "hinting": { "type": "string" },
            "subpixel": { "type": "string" },
            "custom_dpi": { "type": "boolean" },
            "dpi": { "type": "integer", "minimum": 72, "maximum": 240 }
          }
        },
        "legacy": { "type": "string" }
      }
    },
    "control_panel": { "type": "object" },
    "default_apps": {
      "type": "object",
      "properties": {
        "terminal": { "type": "string" },
        "file_manager": { "type": "string" },
        "text_editor": { "type": "string" },
        "terminal_editor": { "type": "string" },
        "browser": { "type": "string" },
        "image_viewer": { "type": "string" },
        "pdf_viewer": { "type": "string" },
        "video_player": { "type": "string" },
        "audio_player": { "type": "string" },
        "archive": { "type": "string" },
        "launcher": { "type": "string" }
      },
      "additionalProperties": false
    },
    "keyboard_shortcuts": {
      "type": "object",
      "patternProperties": {
        "^[a-z0-9]+(?:_[a-z0-9]+)*$": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "hyprland": {
      "type": "object",
      "properties": {
        "keybindings": { "type": "object" },
        "input": { "type": "object" },
        "keyboard": { "type": "object" }
      }
    },
    "displays": {
      "type": "object",
      "properties": {
        "primary_monitor": { "type": ["string", "null"] },
        "monitors": { "type": "object" },
        "workspaces": { "type": "object" }
      }
    },
    "power": {
      "type": "object",
      "properties": {
        "screen_off_minutes": { "type": "integer", "minimum": 0 },
        "lock_minutes": { "type": "integer", "minimum": 0 },
        "keep_awake": { "type": "boolean" },
        "lid_battery": { "type": "string" },
        "lid_ac": { "type": "string" },
        "power_button": { "type": "string" }
      }
    },
    "session": {
      "type": "object",
      "properties": { "language": { "type": "string" } }
    },
    "calendar": { "type": "object" },
    "removable_devices": { "type": "object" },
    "audio": {
      "type": "object",
      "properties": {
        "output_volume": { "type": "integer", "minimum": 0, "maximum": 100 },
        "output_muted": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "extensions": { "type": "object" }
  }
}
